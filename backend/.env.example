# ==============================================================================
# INDICIO ENTERPRISE - VARIABLES DE ENTORNO (PLANTILLA)
# Copiar a backend/.env y completar. NUNCA subir el archivo .env real al repositorio.
# ==============================================================================

# --- Base de datos (PostgreSQL 16 + pgvector) --------------------------------
DATABASE_URL=postgresql://postgres:admin@localhost:5432/indicio

# --- Seguridad (OBLIGATORIAS en produccion) ----------------------------------
# Clave de firma JWT y de los enlaces HMAC de los correos. Generar con: openssl rand -hex 32
JWT_SECRET_KEY=
# Clave simetrica para cifrado en reposo (Fernet). Si se deja vacia se genera un par RSA en backend/keys/
DB_ENCRYPTION_KEY=
# Origenes CORS permitidos separados por coma (en produccion: la URL publica). "*" solo para desarrollo.
ALLOWED_ORIGINS=*

# --- Inteligencia Artificial -------------------------------------------------
# Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-2
# Plan B gratuito si Gemini responde 429/503: https://console.groq.com/
GROQ_API_KEY=

# --- Usuarios iniciales (se crean automaticamente al arrancar el backend) -----
SUPERADMIN_PASSWORD=superadmin123
ADMIN_PASSWORD=admin123
AUDITOR_PASSWORD=auditor123
USER_PASSWORD=user123
N8N_SERVICE_PASSWORD=

# --- Organizacion principal (Tenant 1) ---------------------------------------
# Las demas empresas enlazan su propio Gmail y su propio Bot de Telegram desde la
# pestana "Usuarios y Roles" (se guardan cifrados en la base de datos).
# Gmail: Contrasena de Aplicacion de 16 letras (https://myaccount.google.com/apppasswords)
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_NOTIFY_TO=
# Token de @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
DISABLE_TELEGRAM_BOT=false

# --- URLs publicas (botones de los correos de aprobacion) ---------------------
BACKEND_PUBLIC_URL=http://localhost:8000
FRONTEND_PUBLIC_URL=http://localhost:5173
# En Railway se detecta automaticamente con RAILWAY_PUBLIC_DOMAIN
