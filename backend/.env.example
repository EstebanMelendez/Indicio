# ==============================================================================
# INDICIO ENTERPRISE - VARIABLES DE ENTORNO (PLANTILLA SEGURA)
# NUNCA subas el archivo '.env' real a ningún repositorio de control de versiones.
# ==============================================================================

# Base de Datos (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql://postgres:admin@localhost:5432/indicio

# Inteligencia Artificial (Google Gemini)
# Obtenida en: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-005

# Seguridad Criptográfica y Autenticación JWT
# Generar una clave robusta (ej: openssl rand -hex 32)
JWT_SECRET_KEY=
# Llave simétrica Fernet / AES para cifrado de datos sensibles en PostgreSQL (Opcional, se auto-genera un par RSA en backend/keys si está vacía)
DB_ENCRYPTION_KEY=

# Contraseñas Iniciales de Usuarios del Sistema (Para creación segura con create_admin.py)
ADMIN_PASSWORD=admin123
AUDITOR_PASSWORD=auditor123

# Automatización y Webhooks (n8n)
N8N_SERVICE_PASSWORD=
N8N_WEBHOOK_URL=http://localhost:5678/webhook/document-status
N8N_INVOICE_WEBHOOK_URL=http://localhost:5678/webhook/invoice-approval
N8N_HR_WEBHOOK_URL=http://localhost:5678/webhook/hr-scouting

# Asistente RAG Móvil (Telegram Bot)
# Obtenido con @BotFather en Telegram
TELEGRAM_BOT_TOKEN=
N8N_TELEGRAM_RAG_WEBHOOK_URL=http://localhost:5678/webhook/telegram-rag
